    },
    {
      "id": "2-reflect",
      "label": "本日の反省点（夕反省雛形）",
      "npm": "evening:reflect",
      "wave": "until-pause",
      "filledOk": true
    },
    {
      "id": "3-proposals",
      "label": "運用・体制・MCP・ルール・憲法の改善案 → 浜田承認",
      "pause": true,
      "wave": "until-pause"
    },
    {
      "id": "4-apply-go",
      "label": "承認案の対応（CIO。本 npm は実装しない）",
      "wave": "after-go",
