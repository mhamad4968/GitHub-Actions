{
  "version": "2026-08-08",
  "defaultProfile": "governance",
  "spec": "docs/plans/2026-07-11-mcp-tools-consolidation-spec.md §4 §6.3 · DEL-3 2026-08-08",
  "neverDisable": [
    "deepseek",
    "kimi",
    "openrouter",
    "memory",
    "sequential-thinking",
    "rag",
    "markdownify",
    "kintone",
    "playwright",
    "duckduckgo-search",
    "office-word",
    "office-powerpoint",
    "kintone-space"
  ],
  "deletedDoNotReadd": [
    "mintlify",
    "cyber-news",
    "shadcn-ui",
    "colors-fonts",
    "figma",
    "accessibility-scanner"
  ],
  "intentToProfile": {
    "frontend-ui": "fe",
    "library-docs": "kintone",
    "kintone-schema-live": "kintone",
    "github-ci": "governance",
    "security": "security",
    "doc-lane": "doc-lane"
  },
  "profiles": {
    "governance": {
      "label": "運用日 — Core + Warm · FE Cold disabled",
      "disable": [
        "chrome-devtools",
        "github",
        "kintone-dev",
        "context7"
      ],
      "enable": []
    },
    "kintone": {
      "label": "kintone schema / dev docs",
      "disable": ["chrome-devtools", "github"],
      "enable": ["kintone-dev", "context7", "kintone-schema-mcp"]
    },
    "fe": {
      "label": "FE customize / DevTools（DEL-3後）",
      "disable": ["kintone-dev", "context7", "github"],
      "enable": ["chrome-devtools"]
    },
    "doc-lane": {
      "label": "Word/PPT doc-lane — office protected",
      "disable": ["chrome-devtools", "github"],
      "enable": ["office-word", "office-powerpoint", "markdownify"]
    },
    "security": {
      "label": "CVE / security intent",
      "disable": ["chrome-devtools"],
      "enable": ["cve-search", "duckduckgo-search"]
    }
  }
}
