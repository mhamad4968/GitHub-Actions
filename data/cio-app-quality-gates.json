{
  "version": "2026-06-21",
  "description": "deploy 前 app 固有ゲート — npm run cio:quality-gate -- --deploy <appId>",
  "commitGate": {
    "label": "commit 前（軽量）",
    "steps": [{ "type": "npm", "script": "lint:customize" }]
  },
  "pushGate": {
    "label": "push 前（pre-push hook 同等）",
    "steps": [
      { "type": "npm", "script": "verify:constitution-handoff" },
      { "type": "npm", "script": "lint:customize" },
      { "type": "npm", "script": "jikkou-yosan:pre-push-gate" }
    ]
  },
  "apps": {
    "736": {
      "label": "実行予算書",
      "deployGate": [
        { "type": "npm", "script": "jikkou-yosan:deploy-gate" }
      ],
      "notes": "build → ux-gate → ui/js sync → calc → rowkey → lint。desktop.js 直編集禁止"
    },
    "687": {
      "label": "工事稼働日数",
      "deployGate": [
        { "type": "node", "script": "scripts/workdays-deploy-gate.mjs", "args": ["687"] }
      ]
    },
    "688": {
      "label": "工事稼働日数ダッシュ",
      "deployGate": [
        { "type": "node", "script": "scripts/workdays-deploy-gate.mjs", "args": ["688"] }
      ]
    }
  }
}
