# コピーして使う: cp .env.example .env
# 秘密値（トークン・API キー）は GitHub の Environment「kintone-collect」の Secrets から貼り付け。
# 必須・GitHub 対応表の「埋める場所」一覧: docs/collect-env-settings.md

# ドメイン（ホスト名のみ）またはフル URL（KINTONE_BASE_URL のどちらか一方でよい）
KINTONE_DOMAIN=jbis-kintone.cybozu.com
# KINTONE_BASE_URL=https://jbis-kintone.cybozu.com

# ニュースアプリ ID（GitHub と同じなら KINTONE_APP でも可）
KINTONE_APP_ID=631
# KINTONE_APP=631

# collect のみなら空でも可。analyze では必須
KINTONE_REPORT_APP_ID=632

# collect 用（GitHub Secret KINTONE_API_TOKEN_COLLECT と同じ値）
KINTONE_API_TOKEN_COLLECT=

# 複数アプリを1トークンにまとめる運用のとき。COLLECT があればそちらが優先
# KINTONE_API_TOKEN=

# analyze の週次要約に必須。collect では任意（あると概要・要約を Gemini で体裁付け。外すと RSS トリムのみ）
GEMINI_API_KEY=
# 同一 target_week のレコードが既にあるとき: 省略または update = 上書き、skip = 何もしない（再実行で二重にしたくないとき）
# ANALYZE_EXISTING_WEEK_RECORD=update
# ANALYZE_EXISTING_WEEK_RECORD=skip
# GitHub Actions では GITHUB_RUN_ID が自動注入され 632 の internal_github_run_id に記録される（ローカルでは local）
# collect だけ体裁を付けたくないとき 1
# COLLECT_SKIP_GEMINI_FORMAT=1

# 記事 URL から HTML を取得して Gemini 入力を厚くする（既定: 取得を試みる）。CI 短縮・相手負荷抑制で 0
# COLLECT_FETCH_ARTICLE_BODY=0

# Google Generative AI のモデル ID（省略時は flash-latest → 2.5-flash → 2.5-flash-lite → pro-latest → 3.1-flash-preview の順で試行。404 なら次へ）
# 注意: gemini-1.5-flash・gemini-2.0-flash は v1beta で 404 になりやすい。Variables は空にするか、AI Studio でキーに紐づく ID のみ指定。
# 例（プロジェクトで利用可能な名前だけ有効。https://ai.google.dev/gemini-api/docs/models 参照）:
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-flash-latest

# analyze が OpenAI を使う場合のみ（現行 analyze は Gemini が主）
# OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini

# --- ハイブリッド（複数 RSS ＋ NVD）: 手順は README「ハイブリッド収集（複数 RSS ＋ NVD CVE）— 設定手順【詳細】」 ---
# 複数 RSS: 改行・カンマ・セミコロン（RSS_FEED_URLS があれば SECURITY_NEXT より優先）
# RSS_FEED_URLS=https://www.security-next.com/feed,https://example.com/security.xml
# SECURITY_NEXT_RSS_URL=https://www.security-next.com/feed

# NVD: https://nvd.nist.gov/developers/request-an-api-key（CI は Secret NVD_API_KEY 推奨）
# COLLECT_NVD_ENABLE=1
# NVD_API_KEY=
# NVD_LOOKBACK_DAYS=7
# NVD_MAX_PER_RUN=50
# NOTIFY_WEBHOOK_URL=
# NOTIFY_SUMMARY_WEBHOOK_URL=
