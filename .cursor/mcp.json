{
  "mcpServers": {
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    },
    "colors-fonts": {
      "command": "npx",
      "args": ["-y", "@colorsandfonts/mcp@1.1.0"]
    },
    "mintlify": {
      "url": "https://mcp.mintlify.com"
    },
    "repo-tree": {
      "command": "npx",
      "args": ["-y", "@andredezzy/deep-directory-tree-mcp"],
      "_meta": {
        "purpose": "リポジトリ構造ビジュアル化（画像MCP代替・2026-05-29）"
      }
    },
    "eslint-mcp": {
      "command": "npx",
      "args": ["-y", "@eslint/mcp@latest"],
      "_meta": {
        "purpose": "コード品質自動監査（公式 ESLint MCP・2026-05-29）"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "_meta": {
        "purpose": "ライブラリ/API 最新 docs（kintone JS・React・shadcn 等・2026-06-05）"
      }
    },
    "brave-search": {
      "disabled": true,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": ""
      },
      "_meta": {
        "purpose": "Web 横断検索（brave.com 無料 API key 取得後に disabled 解除）"
      }
    },
    "exa": {
      "disabled": true,
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": ""
      },
      "_meta": {
        "purpose": "セマンティック検索（exa.ai API key 取得後に disabled 解除）"
      }
    },
    "firecrawl": {
      "disabled": true,
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": ""
      },
      "_meta": {
        "purpose": "公式ドキュサイト全文取得（firecrawl.dev key 取得後に disabled 解除）"
      }
    }
  }
}
