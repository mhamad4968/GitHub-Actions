# Copy to `.env` in this directory (`.env` is gitignored). Kintone secrets belong only in `.env`.
# Quick check: `npm run env:check`
#
# ---- Ollama (`npm run user683:ollama-relay` / `user683:sync-summaries:*`)----
# OLLAMA_MODEL must match NAME on the machine reached by OLLAMA_HOST (run `ollama list` there).
# If Ollama runs on another host, set OLLAMA_HOST to http://that-host:11434 (not only 127.0.0.1).
# Scripts default to model `llama3.2` when OLLAMA_MODEL is unset.
OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:latest
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_MODEL=qwen3:8b

# ---- kintone API トークン（アプリ別・混同禁止）----
# Security NEXT 収集/週次: 631 / 632
# KINTONE_APP_ID=631
# KINTONE_API_TOKEN_COLLECT=
# KINTONE_REPORT_APP_ID=632
#
# ICT 掲示板 685 専用（631 用 COLLECT を流用しない）
# KINTONE_API_TOKEN_ICT_COLLECT=
# ICT_DIGEST_STORE_APP_ID=685
#
# customize デプロイ（全アプリ）: KINTONE_USERNAME + KINTONE_PASSWORD 必須
# 監査: npm run cio:audit:portfolio:strict

# ---- VPN 734 月末ライセンス確定リマインド（j-bis.co.jp SMTP）----
# VPN_LICENSE_REMINDER_TO=jb-sys@j-bis.co.jp
# SMTP_HOST=j-bis.co.jp
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hamada-m@j-bis.co.jp

