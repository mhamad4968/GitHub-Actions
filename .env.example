# Copy to `.env` in this directory (`.env` is gitignored). Kintone secrets belong only in `.env`.
# Quick check: `npm run env:check`
#
# ---- Ollama (`npm run user683:ollama-relay` / `user683:sync-summaries:*`)----
# OLLAMA_MODEL must match NAME on the machine reached by OLLAMA_HOST (run `ollama list` there).
# If Ollama runs on another host, set OLLAMA_HOST to http://that-host:11434 (not only 127.0.0.1).
# Scripts default to model `llama3.2` when OLLAMA_MODEL is unset.
OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:latest
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_MODEL=qwen3:8b
