  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "collect": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "rss:verify": "tsx scripts/verify-rss-feeds.mjs",
