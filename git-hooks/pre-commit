#!/bin/sh
# pre-commit — staged ファイルの EOL 維持チェック（A1・2026-05-07 浜田承認）
# インストール: npm run hooks:install
# バイパス（緊急時のみ・破壊的でない場合・浜田承認下のみ）: git commit --no-verify

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

if [ ! -f scripts/cio-eol-check.sh ]; then
  exit 0
fi

bash scripts/cio-eol-check.sh --staged
status=$?
if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "[pre-commit] EOL 維持違反のため commit 中断（A1・2026-05-07 浜田承認）" >&2
  echo "  対処: 上記の sed コマンドで該当ファイルを修正 → git add → 再コミット" >&2
  echo "  バイパス: git commit --no-verify（浜田承認下のみ）" >&2
  exit 1
fi

if command -v node >/dev/null 2>&1; then
  node scripts/cio-precommit-governance-sync.mjs
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "[pre-commit] governance generations 同期 NG — commit 中断" >&2
    exit 1
  fi

  node scripts/cio-report-format-check.mjs --staged
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "[pre-commit] §1 先頭4行（ティア→適用憲法→🎖️→ルール確認）検証 NG（論点9・chat-sessions で先頭がティア行のファイルのみ）" >&2
    echo "  PR 貼付: npm run cio:report-format-check -- --file path/to/pr-body.md" >&2
    echo "  バイパス: git commit --no-verify（浜田承認下のみ）" >&2
    exit 1
  fi

  node scripts/cio-composer-silent-fallback-guard.mjs
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "[pre-commit] 方式B Composer silent-fallback インターロック NG" >&2
    exit 1
  fi

  node scripts/cio-deepseek-5038-evidence-guard.mjs --staged
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "[pre-commit] §50-3-8 証跡なし（customize/SPEC staged）— npm run cio:guard:5038 -- --stamp を先に" >&2
    exit 1
  fi

  node scripts/cio-kintone-apps-garble-check.mjs --staged
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "[pre-commit] kintone-apps.md BUILD/rev garble 検知（R-SEC-02）" >&2
    exit 1
  fi

  node scripts/rag-mirror-canonical-docs.mjs --staged
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "[pre-commit] RAG 正本ミラー不一致 — 同一 commit に正本と副本文を含めてください（§57-10）" >&2
    exit 1
  fi

  if git diff --cached --name-only | grep -qE '^\.cursor/rules/constitution\.mdc$'; then
    node scripts/verify-constitution-mdc-freshness.mjs
    status=$?
    if [ "$status" -ne 0 ]; then
      echo "" >&2
      echo "[pre-commit] constitution.mdc が再生成出力と不一致（手編集禁止）" >&2
      echo "  → npm run rules:regenerate-constitution && npm run verify:constitution-mdc-freshness" >&2
      exit 1
    fi
  fi
fi
exit 0
