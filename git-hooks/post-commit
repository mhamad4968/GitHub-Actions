#!/usr/bin/env bash
# post-commit hook — TSB-016 改善案 #20 / I-9 (2026-04-25 制定)
#
# 目的:
#   commit 直後に verify-breaking-deletions.mjs を走らせ、
#   削除済章/節が無自覚に再復活していないか即座に検知する。
#
# 背景 (TSB-016):
#   2026-04-25 5:41 commit `5f928dd` [BREAKING] が AGENTS.md Ch.17 を削除したが、
#   1.5h 後の無関係 commit `6bac959` が同 Ch.17 を末尾に再追加してしまい、
#   1.7h 誰も気付かずに放置 → H-2 タスクで偶然発見。
#
# 動作:
#   1. 全 commit 後に verify:breaking を実行
#   2. ✅ pass なら silent (邪魔しない)
#   3. ❌ warn なら terminal bell + 強調メッセージ + ログ記録
#   4. 続けて verify-constitution-handoff.mjs（TSB-024 物理ガード）— ng なら bell + ログ（commit は止めない）
#   5. 続けて mandatory-read-gate.mjs（必読ファイル構造）— ng なら bell + ログ（commit は止めない）
#
# インストール: bash scripts/install-hooks.sh
# アンインストール: rm .git/hooks/post-commit
#
# 注意:
#   - hook は exit 0 を必ず返す (commit 自体は止めない)
#   - 並列禁止 §51 遵守 (verify:breaking は単一プロセス)
#   - cron / CI からの commit でも安全に動く (TTY 検出)

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi
cd "$REPO_ROOT"

# Node 実体パス (NVM v24 厳守 / TSB-013 v2 教訓)
NODE_BIN="/home/mhamada202408224/.nvm/versions/node/v24.14.1/bin/node"
if [ ! -x "$NODE_BIN" ]; then
  NODE_BIN="$(command -v node 2>/dev/null || true)"
fi
if [ -z "$NODE_BIN" ]; then
  exit 0
fi

LOG_DIR="logs/git-hooks"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/post-commit.log"

TS="$(date '+%Y-%m-%d %H:%M:%S %Z')"
COMMIT_SHA="$(git rev-parse --short HEAD)"
COMMIT_SUBJECT="$(git log -1 --pretty=format:%s)"

OUTPUT="$("$NODE_BIN" scripts/verify-breaking-deletions.mjs --since=50 2>&1)"
EXIT_CODE=$?

# ✅ pass を含むかチェック
if echo "$OUTPUT" | grep -qE '^✅ pass'; then
  STATUS="pass"
else
  STATUS="warn"
fi

# ログ記録 (常に)
{
  echo "[$TS] commit=$COMMIT_SHA status=$STATUS subject=\"$COMMIT_SUBJECT\""
} >> "$LOG_FILE"

if [ "$STATUS" = "warn" ]; then
  # terminal bell + 強調表示
  printf '\a'
  echo ""
  echo "============================================================"
  echo "  ⚠️  post-commit hook: ZOMBIE RESURRECTION DETECTED"
  echo "============================================================"
  echo "  Commit: $COMMIT_SHA \"$COMMIT_SUBJECT\""
  echo ""
  echo "$OUTPUT" | tail -30
  echo "============================================================"
  echo "  対応: 上記 active-zombie を削除する新 commit を作成"
  echo "       詳細: docs/troubleshooting.md TSB-016"
  echo "============================================================"
fi

# --- TSB-024 / 憲法級ハンドオフ物理ガード（commit 直後に即検知）---
CONST_OUT="$("$NODE_BIN" scripts/verify-constitution-handoff.mjs 2>&1)"
CONST_EXIT=$?
{
  echo "[$TS] commit=$COMMIT_SHA constitution-handoff exit=$CONST_EXIT subject=\"$COMMIT_SUBJECT\""
  if [ "$CONST_EXIT" != "0" ]; then
    echo "$CONST_OUT" | tail -20
  fi
} >> "$LOG_FILE"

if [ "$CONST_EXIT" != "0" ]; then
  printf '\a'
  echo ""
  echo "============================================================"
  echo "  ⚠️  post-commit hook: CONSTITUTION HANDOFF GUARD FAILED"
  echo "============================================================"
  echo "  Commit: $COMMIT_SHA \"$COMMIT_SUBJECT\""
  echo "  詳細: docs/troubleshooting.md TSB-024 / npm run verify:constitution-handoff"
  echo ""
  echo "$CONST_OUT" | tail -25
  echo "============================================================"
  echo "  対応: NEW-SESSION-STARTER 冒頭 🚨 / SESSION-BOOTSTRAP フェーズ7 / TSB-024 本文を復元"
  echo "============================================================"
fi

# --- 必読ファイル構造ゲート（commit 直後）---
MR_OUT="$("$NODE_BIN" scripts/mandatory-read-gate.mjs 2>&1)"
MR_EXIT=$?
{
  echo "[$TS] commit=$COMMIT_SHA mandatory-read-gate exit=$MR_EXIT subject=\"$COMMIT_SUBJECT\""
  if [ "$MR_EXIT" != "0" ]; then
    echo "$MR_OUT" | tail -20
  fi
} >> "$LOG_FILE"

if [ "$MR_EXIT" != "0" ]; then
  printf '\a'
  echo ""
  echo "============================================================"
  echo "  ⚠️  post-commit hook: MANDATORY READ GATE FAILED"
  echo "============================================================"
  echo "  Commit: $COMMIT_SHA \"$COMMIT_SUBJECT\""
  echo "  詳細: npm run verify:mandatory-read-gate / chat-sessions/checkpoint-latest.md 項番 0"
  echo ""
  echo "$MR_OUT" | tail -25
  echo "============================================================"
  echo "  対応: checkpoint 最終更新・handoff 見出し・HANDOFF-HUMAN・SESSION-BOOTSTRAP・AGENTS.md を確認"
  echo "============================================================"
fi

exit 0
