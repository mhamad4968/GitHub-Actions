#!/bin/sh
# post-commit — Node へ委譲（Windows Git / Git-Bash / WSL 共通 / TSB-016 系）
# 実装: scripts/git-hook-post-commit.mjs（内包: verify-breaking / verify-constitution-handoff / mandatory-read-gate.mjs）
# インストール: npm run hooks:install

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0
exec node scripts/git-hook-post-commit.mjs
