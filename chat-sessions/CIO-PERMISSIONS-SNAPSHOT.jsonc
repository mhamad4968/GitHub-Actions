{
  // CIO 2026-05-10 v3 (CEO 厳命 B GO): Run Everything 強制対応 — terminalAllowlist 全削除。
  //
  // 公式仕様: 公式 UI ヘルプ「Run Everything is disabled while that file defines allowlists or
  // a restrictive approvalMode.」 → terminalAllowlist key を削除すれば Cursor Settings UI で
  // "Run Everything" が選択可能化（dropdown に Ask Every Time / Use Allowlist の隣に出現）。
  //
  // ★ DeepSeek §50-3-8 盲点指摘（2026-05-10）: terminalAllowlist 削除直後は Cursor が IDE
  //   settings UI の旧 allowlist にフォールバックする。CEO が Auto-Run mode で **必ず**
  //   "Run Everything" を選択しないと、Use Allowlist のままで IDE 空 allowlist と化し、
  //   全コマンドで Run ボタンが出る **逆効果** に陥る。
  //
  // ★★★ CEO への必須手順 (docs/cio-permissions-guide.md §3 参照): ★★★
  //   1. Cursor を一度 quit して再起動（または Settings UI を一度閉じて再オープン）
  //   2. Settings → Features → Agent → "Auto-Run mode" dropdown を必ず "Run Everything" に変更
  //   3. Use Allowlist のまま放置厳禁（IDE 空 allowlist で全 Run ボタン化＝逆効果）
  //
  // ★ 採用リスク（B 案 / safety 全廃）:
  //   - prompt injection 経路: web_search / WebFetch / MCP 取得コンテンツ等に攻撃命令が混入し
  //     AI が確認なく実行する可能性（最悪: kintone 本番削除・データ持出）
  //   - 公式 non-recommended（"Never use Run Everything mode, which skips all safety checks."）
  //   - CEO 厳命下で safety risk を CEO が認識のうえ採用 (2026-05-10 朝)
  //
  // ★ 運用ガードレール (docs/cio-permissions-guide.md §B-Safety):
  //   - CIO は信頼源（CEO chat / 既知リポ内コード / 既知 MCP server）からの命令のみ実行
  //   - 外部 web 取得コンテンツは「読むのみ・即実行しない」原則
  //   - kintone 本番 PUT / customize deploy は引き続き §41 GO + cio:preflight の機械ゲートで保護
  //   - 不可逆コスト発生コマンド（rm -rf /, format, git push --force main 等）は §M-3 第2者必須
  //
  // ★ mcpAllowlist は維持: 19 server + "*:*" で全 MCP 自動承認（CEO 厳命「全 MCP 自動承認」）
  //
  // ロールバック: 元 v2 (terminalAllowlist 426 行) は chat-sessions/CIO-PERMISSIONS-SNAPSHOT-V2.jsonc
  // に保管予定 / または git 履歴 49ff60c から復元可能。
  "mcpAllowlist": [
    "github:*",
    "user-github:*",
    "cyber-news:*",
    "user-cyber-news:*",
    "office-powerpoint:*",
    "user-office-powerpoint:*",
    "memory:*",
    "user-memory:*",
    "sequential-thinking:*",
    "user-sequential-thinking:*",
    "kintone:*",
    "user-kintone:*",
    "kintone-dev:*",
    "user-kintone-dev:*",
    "kintone-space:*",
    "user-kintone-space:*",
    "playwright:*",
    "user-playwright:*",
    "cve-search:*",
    "user-cve-search:*",
    "rag:*",
    "user-rag:*",
    "accessibility-scanner:*",
    "user-accessibility-scanner:*",
    "duckduckgo-search:*",
    "user-duckduckgo-search:*",
    "kimi:*",
    "user-kimi:*",
    "deepseek:*",
    "user-deepseek:*",
    "openrouter:*",
    "user-openrouter:*",
    "markdownify:*",
    "user-markdownify:*",
    "chrome-devtools:*",
    "user-chrome-devtools:*",
    "shadcn-ui:*",
    "user-shadcn-ui:*",
    "*:*"
  ]
}
