{
  // CIO 2026-05-10: CEO 厳命「Run ボタン完全自動化」対応 v2 — terminalAllowlist 全面拡張。
  // 公式仕様 (https://cursor.com/docs/reference/permissions): JSONC・per-user グローバル・prefix matching・
  // 自動リロード（startup + on-change）。team admin > permissions.json > IDE settings の優先順。
  // permissions.json 定義時は IDE 設定が read-only 化（Auto-Run mode は別管理）。
  // 注意: Auto-Run mode が "Ask Every Time" のままでは allowlist は完全無視される（公式明記）。
  // CEO 厳命に応え、Cursor Settings → Features → Agent → "Auto-Run mode" を
  //   "Auto-Run in Sandbox" または "Run Everything" に切替済の前提で機能する。
  //
  // 過去事故メモ:
  //   - 2026-05-10: スクショ 3 で `if (Test-Path ...) { ... } else { ... }` が Run 化 → `if` token 不在が原因
  //   - 2026-05-09: `Sort-Object` などパイプ終端 cmdlet が Run 化 → `Sort-` 等の prefix で対応
  //   - 2026-05-09: `node -e '...'` の超長一行は token は match するが UI 判定で Run 化することがある
  //     → 回避優先: scripts/*.mjs に切り出して `node scripts/...mjs` で実行（短い行＝マッチしやすい）
  //
  // CVE-2026-22708 (Cursor ≤ 2.2 / 2026-01) は v2.3 で修正済。現在の Cursor は安全。
  "terminalAllowlist": [
    // ── PowerShell 制御構文（2026-05-10 追加 / スクショ 3 の `if (Test-Path ...)` 対応）
    "if",
    "elseif",
    "else",
    "foreach",
    "ForEach-Object",
    "for",
    "while",
    "do",
    "switch",
    "try",
    "catch",
    "finally",
    "throw",
    "function",
    "filter",
    "param",
    "begin",
    "process",
    "end",
    "return",
    "break",
    "continue",

    // ── PowerShell cmdlet prefix（CmdletBinding は Get-/Set-/New- 等 verb-prefix で網羅）
    "Set-",
    "Get-",
    "New-",
    "Remove-",
    "Test-",
    "Out-",
    "Write-",
    "Read-",
    "Add-",
    "Clear-",
    "Copy-",
    "Move-",
    "Rename-",
    "Sort-",
    "Group-",
    "Tee-",
    "Select-",
    "Where-",
    "Invoke-",
    "Start-",
    "Stop-",
    "Wait-",
    "Push-",
    "Pop-",
    "Convert-",
    "ConvertFrom-",
    "ConvertTo-",
    "Compare-",
    "Format-",
    "Measure-",
    "Show-",
    "Trace-",
    "Update-",
    "Use-",
    "Find-",
    "Resolve-",
    "Resume-",
    "Search-",
    "Send-",
    "Skip-",
    "Split-",
    "Step-",
    "Switch-",
    "Sync-",
    "Unblock-",
    "Undo-",
    "Unprotect-",
    "Watch-",
    "Import-",
    "Export-",
    "Restart-",
    "Restore-",
    "Save-",
    "Suspend-",
    "Disable-",
    "Enable-",
    "Register-",
    "Unregister-",
    "Limit-",
    "Lock-",
    "Unlock-",
    "Mount-",
    "Dismount-",
    "Confirm-",
    "Approve-",
    "Deny-",
    "Reset-",
    "Optimize-",
    "Edit-",
    "Expand-",
    "Compress-",
    "Backup-",
    "Checkpoint-",
    "ForEach-",
    "Hide-",
    "Initialize-",
    "Install-",
    "Uninstall-",
    "Publish-",
    "Repair-",
    "Request-",
    "Sync-",
    "Set-Location",
    "Push-Location",
    "Pop-Location",
    "Test-Path",
    "Start-Sleep",

    // ── PowerShell aliases (bare)
    "cd",
    "ls",
