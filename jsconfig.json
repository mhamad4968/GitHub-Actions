{
  "compilerOptions": {
    "checkJs": false,
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "customize/**/*.js",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "security-next-automation",
    "ict-tech-digest-automation",
    "vite-kintone-list-button",
    ".rag",
    "dist",
    "logs",
    "tmp",
    "temp",
    "backups",
    "artifacts",
    "data/snapshots",
    "scripts/mcp-deepseek-v4/node_modules",
    "customize/**/*.bundle.js",
    "**/*.min.js"
  ]
}
